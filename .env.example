PROJECT_NAME=ai-anomaly-ids-idp

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_FLOWS=flows
KAFKA_TOPIC_ALERTS=alerts
KAFKA_GROUP_ID=inference

# Sensor (Kali/Linux only — see implementation.md)
# Use managed-mode WiFi (wlan0), NOT monitor mode (wlan0mon), unless you add 802.11 decapsulation.
# Find interface: ip -br link
SENSOR_INTERFACE=eth0
SENSOR_BPF_FILTER=ip
SENSOR_IDLE_TIMEOUT_SECONDS=60
SENSOR_ACTIVE_TIMEOUT_SECONDS=600
SENSOR_FLUSH_INTERVAL_SECONDS=5
SENSOR_COMPRESS_GZIP=true

# Backend
BACKEND_LOG_LEVEL=info
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Detection thresholds
ISOFOREST_THRESHOLD=0.65
XGBOOST_CONFIDENCE_THRESHOLD=0.70
LSTM_ENABLED=false
LSTM_SEQ_LEN=10
LSTM_RECON_ERROR_THRESHOLD=0.05

# GeoIP (optional)
GEOIP_MMDB_PATH=/data/GeoLite2-City.mmdb

# Redis (dedup)
REDIS_HOST=redis
REDIS_PORT=6379
ALERT_DEDUP_TTL_SECONDS=300

# TimescaleDB
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=ids
POSTGRES_USER=ids
POSTGRES_PASSWORD=ids

# IDP (optional, OFF by default)
IDP_ENABLED=false
IDP_BLOCK_SECONDS=600
IDP_MAX_BLOCKS=50
IDP_CHAIN=AI_IDS_BLOCK
