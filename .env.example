PROJECT_NAME=ai-anomaly-ids-idp

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_FLOWS=flows
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_IDP=idp_actions
KAFKA_GROUP_ID=inference

# Sensor & Network Monitoring
# Use 'any' on Linux servers/Kubernetes nodes to capture north-south and east-west CNI traffic,
# or specify comma-separated interfaces (e.g., eth0,cni0,flannel.1).
SENSOR_INTERFACE=any
SENSOR_BPF_FILTER=ip
SENSOR_IDLE_TIMEOUT_SECONDS=30
SENSOR_ACTIVE_TIMEOUT_SECONDS=120
SENSOR_FLUSH_INTERVAL_SECONDS=3
SENSOR_COMPRESS_GZIP=true
SENSOR_CONNTRACK_ENABLED=true

# Backend API & Security
BACKEND_LOG_LEVEL=info
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_AUTH_ENABLED=false
API_KEY=nids_live_ak_7a8b9c1d2e3f4g5h6i7j8k9l0m1n2o3p

# Core Feature Modules (Required Configuration)
IDS_ENABLED=true
IDP_ENABLED=true
# IDP_ENFORCEMENT_MODE options: monitor | safe_enforce | full_enforce
IDP_ENFORCEMENT_MODE=safe_enforce
IDP_BLOCK_SECONDS=600
IDP_MAX_BLOCKS=100
IDP_CONFIDENCE_THRESHOLD=0.75
IDP_AUTO_BLOCK_CRITICAL=true
IDP_AUTO_BLOCK_HIGH=true
IDP_ALLOWLIST=127.0.0.1/32,::1/128,10.96.0.0/12,10.244.0.0/16
IDP_MANAGEMENT_IPS=127.0.0.1,192.168.1.1,10.0.0.1
IDP_PROTECTED_CIDRS=127.0.0.0/8,10.96.0.0/12,10.244.0.0/16,169.254.0.0/16
IDP_CHAIN=AI_IDS_BLOCK
# IDP_FIREWALL_BACKEND options: auto | iptables | nftables
IDP_FIREWALL_BACKEND=auto
IDP_RATE_LIMIT_RPS=50

# Server-Wide & Kubernetes Monitoring Layers
KUBERNETES_MONITORING_ENABLED=true
KUBERNETES_AUDIT_ENABLED=true
HOST_MONITORING_ENABLED=true
NETWORK_MONITORING_ENABLED=true
APPLICATION_MONITORING_ENABLED=true
WAF_ENABLED=true
LOG_MONITORING_ENABLED=true
THREAT_INTELLIGENCE_ENABLED=true

# AI Detection Thresholds (44-Feature Flow Schema)
ISOFOREST_THRESHOLD=0.65
XGBOOST_CONFIDENCE_THRESHOLD=0.70
LSTM_ENABLED=true
LSTM_SEQ_LEN=10
LSTM_RECON_ERROR_THRESHOLD=0.05

# Host & Log Paths (Mounted from Linux Host in Production)
HOST_PROC_DIR=/proc
HOST_ETC_DIR=/etc
HOST_LOG_DIR=/var/log
WAF_LOG_PATHS=/var/log/nginx/access.log,/var/log/modsec_audit.log
KUBERNETES_AUDIT_LOG_PATH=/var/log/kubernetes/audit/audit.log
MONITOR_INTERVAL_SECONDS=15

# GeoIP Enrichment
GEOIP_MMDB_PATH=/data/GeoLite2-City.mmdb

# Redis (Deduplication & IDP State Sync)
REDIS_HOST=redis
REDIS_PORT=6379
ALERT_DEDUP_TTL_SECONDS=60

# TimescaleDB (Persistence)
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=ids
POSTGRES_USER=ids
POSTGRES_PASSWORD=ids
